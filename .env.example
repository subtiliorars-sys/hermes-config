# Copy this to .env and fill in your values
# Get your Nous token by running: hermes auth add nous
# Get your OpenRouter key from: https://openrouter.ai/keys
# Get your GitHub token from: https://github.com/settings/tokens

OPENROUTER_API_KEY=your_key_here
GITHUB_TOKEN=your_token_here
COPILOT_CLI_PATH=gemini
HERMES_COPILOT_ACP_COMMAND=/path/to/agy_acp_bridge.py
HERMES_COPILOT_ACP_ARGS=--acp --stdio
